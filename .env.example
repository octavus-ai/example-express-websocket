# Octavus Platform URL (defaults to https://octavus.ai)
OCTAVUS_API_URL=https://octavus.ai

# API Key for runtime (required)
OCTAVUS_API_KEY=your-api-key

# API Key for CLI sync (optional, uses OCTAVUS_API_KEY if not set)
OCTAVUS_CLI_API_KEY=your-cli-api-key

# Agent ID (obtained after running agents:sync)
OCTAVUS_AGENT_ID=your-agent-id

# Server port (defaults to 3001)
PORT=3001
